# ==============================================================================
# BharatTrip Refund Intelligence - Environment Configuration Template
# ==============================================================================
# Copy this template to .env and configure local values before starting the application:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL or Local SQLite)
# ------------------------------------------------------------------------------
# Production (Neon PostgreSQL with connection pooling & SSL required):
# Obtain connection string from Neon Console (choose "Pooled connection"):
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Local Development / Testing (SQLite file path fallback when DATABASE_URL is unset):
DATABASE=bharattrip.db

# ------------------------------------------------------------------------------
# 2. Cryptographic Secret Key (Mandatory in production)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_64_character_hex_secret_here

# ------------------------------------------------------------------------------
# 3. Operator Authentication (Mandatory in production)
# ------------------------------------------------------------------------------
OPERATOR_USERNAME=operator
# Generate a PBKDF2/scrypt password hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourSecurePasswordHere'))"
OPERATOR_PASSWORD_HASH=your_generated_werkzeug_password_hash_here

# ------------------------------------------------------------------------------
# 4. Runtime Environment & Security Settings
# ------------------------------------------------------------------------------
FLASK_ENV=production
TESTING=False
# Set to True in production (HTTPS required by Vercel), False for local HTTP:
SESSION_COOKIE_SECURE=True
WTF_CSRF_ENABLED=True

# ------------------------------------------------------------------------------
# 5. Groq Cloud API Configuration (for live AI intake extraction)
# ------------------------------------------------------------------------------
# Obtain an API key from https://console.groq.com/
# Leave empty to run with offline fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT=30.0
