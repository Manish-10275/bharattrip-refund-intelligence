# ==============================================================================
# BharatTrip Refund Intelligence - Environment Configuration Template
# ==============================================================================
# Copy this template to .env and configure local values before starting the application:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# Cryptographic Secret Key (Mandatory in production)
# Generate a strong 256-bit secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_64_character_hex_secret_here

# Operator Credentials
OPERATOR_USERNAME=operator
# Generate a PBKDF2/scrypt password hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourSecurePasswordHere'))"
OPERATOR_PASSWORD_HASH=your_generated_werkzeug_password_hash_here

# Runtime Security Settings
TESTING=False
SESSION_COOKIE_SECURE=False
WTF_CSRF_ENABLED=True

# Groq Cloud API Configuration (for live AI intake extraction)
# Obtain an API key from https://console.groq.com/
# Leave empty to run with offline mock fixtures
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT=30.0
